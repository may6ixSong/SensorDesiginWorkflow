# Calypso Web - local environment
# Copy to .env and adjust if a service runs on a different host/port.

# Calypso's own backend (calypso/). Default dev port is 3010 (calypso/.env.example PORT=3010).
CALYPSO_API=http://localhost:3010/api/v1

# SIREN's backend (api/) — Calypso reads the Project List/detail from here
# (SIREN is the hub that owns projects; Calypso only owns artifacts). Default dev
# port is 3000. SIREN api's CORS_ORIGIN must include this app's origin
# (http://localhost:5174) for these calls to work in the browser.
SIREN_API=http://localhost:3000/api/v1

# --- Common platform APIs (shared across internal web apps, same values as web/.env) ---
MOBILAVE=
USER_GROUP_API=
SDP_COMMON_API=
SYSTEM_API=

# 'dev' | 'prod' — 'dev' skips ADSSO and auto-logs in as a fixed admin user.
ENVIRONMENT=dev
