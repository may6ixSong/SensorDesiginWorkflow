# Calypso - 환경 변수 템플릿
# .env.development (개발) / .env.production (운영) 으로 복사해서 값을 채운다.
# SIREN api(api/.env.example)와 같은 키 구성을 그대로 쓴다 - 설계서 §3.7.

# --- Server ---
PORT=3010
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Observer 계약의 viewUrl이 이 값으로 만들어진다 - SIREN이 사용자를 이 주소로 보낸다.
PUBLIC_BASE_URL=http://localhost:5174

# --- MongoDB ---
# SIREN api와 동일하게 AES 암호문이다.
DB_CONNECTION=
AES_KEY=

# --- Object Storage (S3 호환) ---
# ★ S3_FOLDER는 반드시 SIREN 본체(siren/siren-dev)와 다른 값을 쓴다 - 같은 스토리지를
#   쓰더라도 네임스페이스는 분리한다는 게 "실물 파일은 각 서비스가 소유한다"는 원칙의
#   자격증명·prefix 레벨 구현이다 (Hub 설계서 §1.2, §3.7).
S3_URI=
S3_BUCKET_NAME=
S3_FOLDER=calypso-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SIREN BE 호출 인증 (docs/07-hub-operations.md §2, common/siren-caller.guard.ts) ---
# SIREN BE가 이 api를 부를 때 실어 보내는 X-Siren-Token 헤더를 이 값과 대조한다. SIREN
# 쪽 CALYPSO_API_TOKEN과 같은 값이어야 한다. 비어 있으면(로컬 개발 기본값) 검증을
# 건너뛴다 — 운영 배포 시 반드시 설정할 것.
SIREN_CALLER_TOKEN=

# --- Version 발행 이벤트 전송용 토큰 (반대 방향, docs/07-hub-operations.md §3.4) ---
# ★ Calypso가 아직 이 이벤트를 실제로 보내는 코드는 없다 — 나중에 그 기능을 붙일 때
#   `Authorization: Bearer <값>`으로 SIREN의 POST /hub/events/version-published 에 실어
#   보내면 된다. 로컬 mock 모드에서는 SIREN의 database/seed-data.ts에 심어둔
#   DEV_CALYPSO_EVENT_TOKEN(mock-token-calypso)과 같은 값을 써야 매칭된다. 운영 값은 SIREN이
#   다른 서비스처럼 DB에 직접 발급해 넣은 값을 그대로 받아 쓴다.
CALYPSO_EVENT_TOKEN=
