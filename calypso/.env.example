# Calypso - 환경 변수 템플릿
# .env.development (개발) / .env.production (운영) 으로 복사해서 값을 채운다.
# SIREN api(api/.env.example)와 같은 키 구성을 그대로 쓴다 - 설계서 §3.7.

# --- Server ---
PORT=3010
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Observer 계약의 viewUrl이 이 값으로 만들어진다 - SIREN이 사용자를 이 주소로 보낸다.
PUBLIC_BASE_URL=http://localhost:5174

# --- MongoDB ---
# SIREN api와 동일하게 AES 암호문이다.
DB_CONNECTION=
AES_KEY=

# --- Object Storage (S3 호환) ---
# ★ S3_FOLDER는 반드시 SIREN 본체(siren/siren-dev)와 다른 값을 쓴다 - 같은 스토리지를
#   쓰더라도 네임스페이스는 분리한다는 게 "실물 파일은 각 서비스가 소유한다"는 원칙의
#   자격증명·prefix 레벨 구현이다 (Hub 설계서 §1.2, §3.7).
S3_URI=
S3_BUCKET_NAME=
S3_FOLDER=calypso-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- SIREN BE 호출 인증 (docs/07-hub-operations.md §2, common/siren-caller.guard.ts) ---
# SIREN BE가 이 api를 부를 때 실어 보내는 X-Siren-Token 헤더를 이 값과 대조한다. SIREN
# 쪽 CALYPSO_API_TOKEN과 같은 값이어야 한다. 비어 있으면(로컬 개발 기본값) 검증을
# 건너뛴다 — 운영 배포 시 반드시 설정할 것.
SIREN_CALLER_TOKEN=

# --- Calypso → SIREN 역방향 호출 (siren-common/) ---
# 이 두 값은 siren-common/의 두 발신 경로가 함께 쓴다 —
#   1) Access 패널의 부서/멤버 로스터 조회(SirenCommonService, GET /hub/common)
#   2) publish/upload 즉시 알림(HubEventSenderService, POST /hub/events/version-published —
#      SIREN이 이미 이 artifact를 매핑해 뒀으면 그 자리에서 SIREN의 버전 캐시를 갱신한다)
# SIREN_BASE_URL은 SIREN api의 베이스 URL(포트/프리픽스 포함). CALYPSO_EVENT_TOKEN은
# 두 호출 모두에 Bearer로 실어 보내는 값 — 비어 있으면 개발/목업 기본값('mock-token-calypso',
# SIREN database/seed-data.ts의 DEV_CALYPSO_EVENT_TOKEN)을 쓴다. 운영 배포에서는 반드시
# 실제 발급한 Calypso 토큰으로 채울 것.
SIREN_BASE_URL=http://localhost:3000/api/v1
CALYPSO_EVENT_TOKEN=
