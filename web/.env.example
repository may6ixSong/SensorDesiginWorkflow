# SIREN Web - local environment
# Copy to .env and adjust if a service runs on a different host/port.
# Values here are intentionally blank for the common-platform APIs — fill them
# in locally. This mirrors the .env.development/.env.production structure.

# SIREN's own backend (api/). Default dev port is 3001 (api/.env.example PORT=3001) —
# 3000 is left to SDP_SPA's dev server, which hosts the sheet editor.
SIREN_API=http://localhost:3001/api/v1
# Calypso's backend — the artifact management page calls it directly (§11.5).
CALYPSO_API=http://localhost:3010/api/v1

# SpreadJS sheet editor page embedded as an iframe (docs/11-sheet-artifacts.md).
# dev: SDP_SPA's dev server (npm start, :3000). Without SDP_SPA, use the in-repo
# sheet-host/ dev server instead: http://localhost:5175/
# prod: SDP_SPA's /sheet-host route (licensed domain).
SHEET_HOST_URL=http://localhost:3000/sheet-host

# --- Common platform APIs (shared across internal web apps) ---
# Corporate ADSSO gateway — login redirect target. Not used in dev (ENVIRONMENT=dev
# auto-logs in as a fixed admin instead — see src/app/providers/AuthProvider.tsx).
MOBILAVE=
# Platform user group/authority/preferences (theme, language) service.
USER_GROUP_API=
# SDP common service (employee directory lookups).
SDP_COMMON_API=
# Platform system service (notices, SignalR hub).
SYSTEM_API=

# 'dev' | 'prod' — 'dev' skips ADSSO and auto-logs in as a fixed admin user.
ENVIRONMENT=dev
