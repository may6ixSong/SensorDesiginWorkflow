# SIREN API - 환경 변수 템플릿
# .env.development (개발) / .env.production (운영) 으로 복사해서 값을 채운다.
# 두 파일 모두 .gitignore 대상이다 - AES_KEY와 S3 시크릿이 들어가므로 절대 커밋하지 않는다.
# NODE_ENV=production 이면 .env.production, 그 외에는 .env.development 를 읽는다. (src/config/env.ts)

# --- Server ---
# dev: 3000 / prod: 44350
PORT=3000
API_PREFIX=api/v1
# 비우거나 '*'로 두면 요청 오리진 전면 허용. 쉼표로 여러 오리진 지정 가능.
# dev는 http://localhost:5173, prod는 '*'를 쓴다.
CORS_ORIGIN=http://localhost:5173

# --- 목업 데이터 ---
# true  : 목업 문서가 없으면 부팅 시 한 번 시드한다 (모든 목업에 isMock:true 표시).
#         이미 있으면 건너뛰므로, 화면에서 목업을 수정한 결과는 재시작 후에도 남는다.
# false : 부팅 시 isMock:true 문서만 일괄 삭제한다. isMock:false(실제 데이터)는 건드리지 않는다.
MOCKUP_ENABLED=true

# --- MongoDB (database: siren) ---
# DB_CONNECTION은 평문이 아니라 AES 암호문이다 (SFM_API와 동일한 방식).
# 암호문 생성:
#   node -e "console.log(require('crypto-js').AES.encrypt('mongodb://<host>:<port>/siren','<AES_KEY>').toString())"
# 둘 중 하나라도 비어 있으면 실제 DB에 연결하지 않고 인메모리 목업 모드로 동작한다.
DB_CONNECTION=
AES_KEY=

# --- Object Storage (S3 호환) ---
# SFM_API의 files.service.ts와 동일하게 @relaycorp/object-storage로 접속한다.
# S3_FOLDER는 버킷 내 SIREN 전용 prefix - dev는 siren-dev, prod는 siren.
S3_URI=
S3_BUCKET_NAME=
S3_FOLDER=siren-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- HPC-OA 공용 DB (Hub B 티어 동기화, docs/siren-artifact-hub-design.md §8) ---
# DB_CONNECTION과 달리 AES 암호화하지 않는다 - 평문 주소로 바로 접속.
# 컬렉션명은 아직 미확정 (사내 인프라에 사전 신청 필요, 같은 문서 §8.8 참고).
HPC_OA_SHARED_DB_URI=
