# ARBOR API - local environment
# Copy to .env and fill in real values before running `npm run start:dev`.

# --- Server ---
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173

# --- MongoDB ---
# 킥오프 프롬프트 [A]에서 지정된 개발 DB 주소. DB 이름은 필요에 따라 바꿔도 됨.
MONGODB_URI=mongodb://10.172.42.128:27017/arbor

# --- Auth (mock SSO / dev bypass) ---
# 실제 사내 SSO 연동 전까지 사용하는 개발용 JWT 서명 비밀값.
# TODO: SSO 연동 지점 - 이 시크릿/발급 로직을 실제 IdP 토큰 검증으로 교체한다. (src/auth/auth.service.ts, src/auth/jwt-auth.guard.ts 참조)
DEV_JWT_SECRET=arbor-dev-secret-change-me
DEV_JWT_EXPIRES_IN=8h

# --- Object Storage (S3 호환, presigned URL) ---
# 개발자가 로컬 환경에서 채워넣을 것 (킥오프 프롬프트 [A] 지시사항). 값이 비어있으면
# storage 모듈은 presigned URL 대신 로컬 목(mock) 경로를 반환한다.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- 공통 플랫폼 서비스 (현재 미연동, 추후 반영 예정) ---
# TODO: 조직도/HR API 연동 지점 - 연동 전까지 users 컬렉션을 직접 관리한다.
HR_API_BASE_URL=
# TODO: 사내 알림(메일/메신저) 서비스 연동 지점 - Release 시 recvDept/recvContact 통보에 사용 예정 (설계서 8.1-7).
NOTIFICATION_SERVICE_URL=
